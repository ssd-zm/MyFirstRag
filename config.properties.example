# 复制此文件为 config.properties 并填写两个 key
# （config.properties 含密钥，已被 .gitignore 忽略，不要提交）
# 也可完全用环境变量: RAG_CHAT_API_KEY / RAG_EMBED_API_KEY / RAG_*_BASE_URL / RAG_*_MODEL

# ---- chat: DeepSeek（RAG 问答）----
chatBaseUrl=https://api.deepseek.com
chatApiKey=
chatModel=deepseek-chat

# ---- embedding: 硅基流动（DeepSeek 不提供 embedding 接口，所以用另一家）----
# 注册 https://siliconflow.cn 拿 key，bge-m3 有免费额度
embedBaseUrl=https://api.siliconflow.cn/v1
embedApiKey=
embedModel=BAAI/bge-m3

# ---- 或者一家全包（阿里百炼，一个 key 搞定）----
# chatBaseUrl=https://dashscope.aliyuncs.com/compatible-mode/v1
# embedBaseUrl=https://dashscope.aliyuncs.com/compatible-mode/v1
# chatModel=qwen-plus
# embedModel=text-embedding-v3
# （智谱: https://open.bigmodel.cn/api/paas/v4  chatModel=glm-4-flash  embedModel=embedding-3）

# ---- 切片与检索参数（Phase 3 评测时要对照调整的三个旋钮）----
chunkChars=500
overlapChars=80
topK=4
embedBatch=16

# 打印每次 HTTP 请求耗时与检索分数
debug=true
